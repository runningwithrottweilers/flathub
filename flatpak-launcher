#!/bin/sh
export XARCH_BACKEND=/app/bin/xarch-theme-studio

# Przy braku WAYLAND_DISPLAY wykryj dostepne gniazdo.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
        [ -S "$socket" ] || continue
        WAYLAND_DISPLAY=${socket##*/}
        export WAYLAND_DISPLAY
        break
    done
fi

exec python3 /app/share/xarch-theme-studio/gui/studio.py "$@"
